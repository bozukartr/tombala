{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[0-9]{5}$/)",
        ".write": "auth != null && $code.matches(/^[0-9]{5}$/) && ((!data.exists() && newData.child('meta/hostId').val() === auth.uid) || (data.exists() && data.child('meta/expiresAt').val() <= now && (!data.child('members/' + data.child('meta/hostId').val() + '/connected').exists() || data.child('members/' + data.child('meta/hostId').val() + '/connected').val() === false || data.child('meta/status').val() === 'finished' || data.child('meta/expiresAt').val() < now - 86400000) && newData.child('meta/hostId').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('meta/hostId').val() === auth.uid))",
        ".validate": "newData.hasChildren(['meta', 'members', 'game'])",
        "meta": {
          ".write": "auth != null && data.child('hostId').val() === auth.uid",
          ".validate": "newData.hasChildren(['hostId', 'status', 'createdAt', 'expiresAt', 'settings'])",
          "hostId": {
            ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists() && (!root.child('rooms/' + $code + '/members/' + data.val()).exists() || root.child('rooms/' + $code + '/members/' + data.val() + '/connected').val() === false)",
            ".validate": "newData.isString() && root.child('rooms/' + $code + '/members/' + newData.val()).exists()"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'finished')"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && ((data.exists() && root.child('rooms/' + $code + '/meta/expiresAt').val() > now && newData.val() === data.val()) || ((!data.exists() || root.child('rooms/' + $code + '/meta/expiresAt').val() <= now) && newData.val() >= now - 120000 && newData.val() <= now + 10000))"
          },
          "expiresAt": {
            ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 21900000"
          },
          "settings": {
            ".validate": "newData.hasChildren(['drawMode', 'drawInterval', 'autoMark'])",
            "drawMode": { ".validate": "newData.val() === 'auto' || newData.val() === 'manual'" },
            "drawInterval": { ".validate": "newData.isNumber() && (newData.val() === 4000 || newData.val() === 6000 || newData.val() === 8000)" },
            "autoMark": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || data.exists() || root.child('rooms/' + $code + '/meta/status').val() === 'lobby')",
            ".validate": "newData.hasChildren(['name', 'avatar', 'color', 'ready', 'ticket', 'marked', 'connected', 'joinedAt']) && (root.child('rooms/' + $code + '/meta/status').val() === 'lobby' || !data.exists() || newData.child('ticket').val() === data.child('ticket').val()) && (!data.exists() || newData.child('joinedAt').val() === data.child('joinedAt').val())",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16" },
            "avatar": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 8" },
            "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
            "ready": { ".validate": "newData.isBoolean()" },
            "ticket": { ".validate": "newData.isString() && newData.val().length <= 80 && newData.val().matches(/^([0-9]{1,2},){26}[0-9]{1,2}$/)" },
            "marked": { ".validate": "newData.isString() && newData.val().length <= 270 && newData.val().matches(/^$|^([1-9]|[1-8][0-9]|90)(,([1-9]|[1-8][0-9]|90))*$/)" },
            "connected": { ".validate": "newData.isBoolean()" },
            "joinedAt": { ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() >= now - 120000 && newData.val() <= now + 10000))" },
            "$other": { ".validate": false }
          }
        },
        "game": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid",
          ".validate": "newData.hasChildren(['drawn', 'lastNumber', 'revision', 'updatedAt'])",
          "drawn": { ".validate": "newData.isString() && newData.val().length <= 270 && newData.val().matches(/^$|^([1-9]|[1-8][0-9]|90)(,([1-9]|[1-8][0-9]|90))*$/)" },
          "lastNumber": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 90" },
          "revision": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 90" },
          "updatedAt": { ".validate": "newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 10000" },
          "$other": { ".validate": false }
        },
        "winners": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid",
          "cinko1": { "$uid": { ".validate": "newData.val() === true && root.child('rooms/' + $code + '/members/' + $uid).exists()" } },
          "cinko2": { "$uid": { ".validate": "newData.val() === true && root.child('rooms/' + $code + '/members/' + $uid).exists()" } },
          "tombala": { "$uid": { ".validate": "newData.val() === true && root.child('rooms/' + $code + '/members/' + $uid).exists()" } },
          "$other": { ".validate": false }
        },
        "claims": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/members/' + $uid).exists() && root.child('rooms/' + $code + '/meta/status').val() === 'playing' && (!newData.exists() || !data.exists())",
            ".validate": "newData.hasChildren(['type', 'atDraw', 'createdAt'])",
            "type": { ".validate": "newData.val() === 'cinko1' || newData.val() === 'cinko2' || newData.val() === 'tombala'" },
            "atDraw": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 90" },
            "createdAt": { ".validate": "newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 10000" },
            "$other": { ".validate": false }
          }
        },
        "claimResults": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !newData.exists()",
            ".validate": "newData.hasChildren(['type', 'valid', 'reason', 'resolvedAt'])",
            "type": { ".validate": "newData.val() === 'cinko1' || newData.val() === 'cinko2' || newData.val() === 'tombala'" },
            "valid": { ".validate": "newData.isBoolean()" },
            "reason": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "resolvedAt": { ".validate": "newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 10000" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
