{
  "name": "tombala",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "firebase emulators:start --only hosting",
    "test": "npm run test:unit && npm run test:rules",
    "test:unit": "node --test tests/ticket.unit.test.js tests/game.unit.test.js tests/local-service.unit.test.js tests/ui-static.unit.test.js",
    "test:rules": "firebase emulators:exec --only database --project demo-tombala \"node --test tests/rules.test.js\"",
    "deploy:rules": "firebase deploy --only database",
    "deploy": "firebase deploy --only hosting,database"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase": "12.17.1",
    "firebase-tools": "15.26.0"
  }
}
